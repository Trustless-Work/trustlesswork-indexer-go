{
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(gofmt -l *)",
      "Bash(make test*)",
      "Bash(make vet*)",
      "Bash(make build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(rm * indexer.state*)",
      "Bash(make reset-state*)",
      "Bash(railway *)",
      "Read(./.env)",
      "Read(./indexer.state.json)",
      "Read(./indexer.watchlist.seed.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/skills/context-sync/scripts/context-sync.sh check-session",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/skills/context-sync/scripts/context-sync.sh check-prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/skills/context-sync/scripts/context-sync.sh check-bash",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/skills/context-sync/scripts/context-sync.sh check-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
